{
  "manifest_version": 3,
  "name": "GrammarCheck · Tiếng Việt",
  "version": "1.0.0",
  "description": "Kiểm tra tài liệu, hỗ trợ học tiếng Việt và chuẩn hóa dữ liệu NLP.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {"default_title": "GrammarCheck · Tiếng Việt", "default_popup": "index.html"},
  "background": {"service_worker": "service-worker.js"},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https:"
  }
}
